{
  "id": "products",
  "version": "1.3.0",
  "apiVersion": "2.0",
  "assets": { "styles": ["./dist/assets/tailwind.css"] },
  "contributes": {
    "repositories": [
      {
        "module": "./dist/repositories/category.repository.js",
        "export": "CategoryRepository",
        "prefix": "products.categories",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "search",
          "listTree",
          "listByParent",
          "countProducts"
        ]
      },
      {
        "module": "./dist/repositories/product.repository.js",
        "export": "ProductRepository",
        "prefix": "products.items",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "search",
          "findBySku",
          "findByBarcode",
          "listByCategory",
          "listLowStock",
          "countByCategory",
          "adjustStock"
        ]
      },
      {
        "module": "./dist/repositories/variant.repository.js",
        "export": "VariantRepository",
        "prefix": "products.variants",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "softDelete",
          "restore",
          "listByProduct",
          "findBySku",
          "findByBarcode"
        ]
      },
      {
        "module": "./dist/repositories/stock-movement.repository.js",
        "export": "StockMovementRepository",
        "prefix": "products.stock",
        "actions": [
          "list",
          "getById",
          "create",
          "listByProduct",
          "listByVariant",
          "listByBatch",
          "consumedByBatch",
          "getBalance",
          "getSummary"
        ]
      },
      {
        "module": "./dist/repositories/batch.repository.js",
        "export": "BatchRepository",
        "prefix": "products.batches",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "listByProduct",
          "listAvailable",
          "previewConsume",
          "consume",
          "getExpiringSoon",
          "getExpired"
        ]
      }
    ],
    "settings": {
      "groups": [{ "id": "products", "label": "Inventario", "order": 60 }],
      "pages": [
        {
          "id": "products.stock",
          "group": "products",
          "label": "Stock y vencimientos",
          "icon": "Boxes",
          "order": 10
        },
        {
          "id": "products.pricing",
          "group": "products",
          "label": "Precios",
          "icon": "DollarSign",
          "order": 20
        }
      ],
      "sections": [
        {
          "id": "products.stock.expiration",
          "page": "products.stock",
          "label": "Vencimientos",
          "order": 10,
          "items": [
            {
              "key": "products.stock.alertDays",
              "type": "number",
              "label": "Días de aviso de vencimiento",
              "description": "Con cuántos días de anticipación un lote se marca \"por vencer\" en el inventario.",
              "default": 30,
              "min": 1,
              "max": 365,
              "tags": ["stock", "vencimiento", "alerta", "dias"]
            },
            {
              "key": "products.stock.expiredLots",
              "type": "enum",
              "label": "Lotes vencidos",
              "description": "Qué hacer al intentar usar un lote vencido: bloquearlo, o avisar y permitir usarlo igual.",
              "default": "block",
              "options": [
                { "value": "block", "label": "Bloquear" },
                { "value": "warn", "label": "Avisar y permitir" }
              ],
              "tags": ["stock", "vencido", "politica", "lote"]
            }
          ]
        },
        {
          "id": "products.stock.behavior",
          "page": "products.stock",
          "label": "Descuento de stock",
          "order": 20,
          "items": [
            {
              "key": "products.stock.autoDeduct",
              "type": "boolean",
              "label": "Descontar stock automáticamente",
              "description": "Al registrar el uso de un producto (medicación en consulta, venta o receta), descontar su stock de los lotes.",
              "default": true,
              "tags": ["stock", "descontar", "automatico", "deduct"]
            }
          ]
        },
        {
          "id": "products.pricing.margin",
          "page": "products.pricing",
          "label": "Márgenes",
          "order": 10,
          "items": [
            {
              "key": "products.pricing.defaultMargin",
              "type": "number",
              "label": "Margen por defecto (%)",
              "description": "Margen que se aplica sobre el precio de compra para sugerir el precio de venta al cargar un producto. Ej.: costo $100 con margen 50% sugiere $150. 0 = no sugerir precio de venta.",
              "default": 0,
              "min": 0,
              "max": 1000,
              "tags": [
                "products",
                "pricing",
                "defaultmargin",
                "margen",
                "defecto"
              ]
            }
          ]
        }
      ]
    }
  }
}
